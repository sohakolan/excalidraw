MODE="production"

# ---------------------------------------------------------------------------
# Self-hosted fork: every value below is intentionally empty so the app does
# NOT talk to any Excalidraw-owned server. Fill a value only if you self-host
# the matching backend yourself.
# ---------------------------------------------------------------------------

# JSON backend used for read-only "shareable links" (#json=...).
# Empty = shareable links are disabled.
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# External library store (browse / publish community libraries).
# Empty = buttons are hidden, local libraries keep working.
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# Excalidraw+ promotions / sign in. Empty = all promos are hidden.
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=

# AI text-to-diagram backend. Empty = AI features are disabled.
VITE_APP_AI_BACKEND=

# WebSocket server used for real-time collaboration.
# Empty = collaboration is disabled.
VITE_APP_WS_SERVER_URL=

# Firebase project used for collab/share image persistence.
# Empty object = never initialized.
VITE_APP_FIREBASE_CONFIG='{}'

# No tracking, no Sentry.
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_SENTRY=true

# Set the below flags explicitly to false in production mode since vite loads and merges .env.local vars when  running the build command
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
# Enable eslint in dev server
VITE_APP_ENABLE_ESLINT=false
